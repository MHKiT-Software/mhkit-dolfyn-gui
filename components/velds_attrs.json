    "u": {
      "name": "velds.u",
      "docstring": "The first velocity component.\n\nThis is simply a shortcut to self['vel'][0]. Therefore,\ndepending on the coordinate system of the data object\n(self.attrs['coord_sys']), it is:\n\n- beam:      beam1\n- inst:      x\n- earth:     east\n- principal: streamwise",
      "attrs": {
        "units": "m s-1",
        "coverage_content_type": "physicalMeasurement",
        "long_name": "Water Velocity"
      },
      "dims": ["range", "time"]
    },
